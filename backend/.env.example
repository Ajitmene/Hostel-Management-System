# ---------- Django ----------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# ---------- MySQL ----------
DB_NAME=hostel_db
DB_USER=hostel_user
DB_PASSWORD=replace-with-your-db-password
DB_HOST=localhost
DB_PORT=3306

# ---------- FastAPI / JWT ----------
# Must differ from DJANGO_SECRET_KEY. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Comma-separated origins allowed to call the API (no wildcard)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cookies. In production set COOKIE_SECURE=True and serve everything over HTTPS.
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
# Leave empty in development. In production on subdomains, set e.g. .example.com
COOKIE_DOMAIN=

# Enables POST /api/v1/auth/token (bearer tokens for Swagger UI / Postman).
# Turn OFF in production.
ENABLE_BEARER_TOKEN_ENDPOINT=True
